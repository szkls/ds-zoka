{
  "name": "Button",
  "figmaPage": "↳ Button",
  "props": {
    "label": {"type": "TEXT", "default": "Button"},
    "show-icon-left": {"type": "BOOLEAN", "default": true},
    "icon-left": {"type": "INSTANCE_SWAP", "default": "CaretLeft"},
    "show-icon-right": {"type": "BOOLEAN", "default": true},
    "icon-right": {"type": "INSTANCE_SWAP", "default": "CaretRight"},
    "icon": {"type": "INSTANCE_SWAP", "default": "Copy", "note": "icon-only=True"},
    "type": {"type": "VARIANT", "options": ["brand", "destructive", "static-black", "static-white"], "default": "brand"},
    "style": {"type": "VARIANT", "options": ["filled", "stroke", "lighter", "ghost"], "default": "filled"},
    "state": {"type": "VARIANT", "options": ["default", "hover", "focus", "disabled"], "default": "default"},
    "size": {"type": "VARIANT", "options": ["md", "sm", "xs"], "default": "md"},
    "icon-only": {"type": "VARIANT", "options": ["False", "True"], "default": "False"}
  },
  "anatomy": {
    "root": {"layout": "HORIZONTAL", "align": "CENTER/CENTER", "gap": 0, "radius": "radius/md", "widthHug": true},
    "Icon left / Icon right": {"size": "size/3xs", "strokeWeight": 1.5, "color": "= label colour (icon token)"},
    "Label wrap": {"layout": "HORIZONTAL", "pad": "0 padding/2xs 0 padding/2xs"},
    "Label": {"textStyle": "sm/medium"}
  },
  "sizes": {
    "md": {"height": "size/xl", "padX": "padding/md"},
    "sm": {"height": "size/lg", "padX": "padding/sm"},
    "xs": {"height": "size/md", "padX": "padding/2xs"},
    "icon-only": {"note": "width = height token, padding 0, single Icon size/3xs"}
  },
  "strokeWeight": "border/xs (1) when a border is present",
  "columns": ["bg", "border", "text", "icon", "effect", "opacity"],
  "matrix": {
    "brand, filled, default": "background/brand/base | - | text/neutral/extra-subtle | icon/neutral/extra-subtle | - | -",
    "brand, stroke, default": "background/neutral/extra-subtle | border/brand/base | text/brand/base | icon/brand/base | - | -",
    "brand, lighter, default": "background/brand/subtlest | - | text/brand/base | icon/brand/base | - | -",
    "brand, ghost, default": "- | - | text/brand/base | icon/brand/base | - | -",
    "brand, filled, hover": "background/brand/bold | - | text/neutral/extra-subtle | icon/neutral/extra-subtle | - | -",
    "brand, stroke, hover": "background/brand/subtlest | border/brand/base | text/brand/base | icon/brand/base | - | -",
    "brand, lighter, hover": "background/brand/subtler | - | text/brand/base | icon/brand/base | - | -",
    "brand, ghost, hover": "background/brand/subtlest | - | text/brand/base | icon/brand/base | - | -",
    "brand, filled, focus": "background/brand/base | - | text/neutral/extra-subtle | icon/neutral/extra-subtle | focus-ring/brand | -",
    "brand, stroke, focus": "background/neutral/extra-subtle | border/brand/base | text/brand/base | icon/brand/base | focus-ring/brand | -",
    "brand, lighter, focus": "background/brand/subtlest | - | text/brand/base | icon/brand/base | focus-ring/brand | -",
    "brand, ghost, focus": "background/neutral/extra-subtle | - | text/brand/base | icon/brand/base | focus-ring/brand | -",
    "brand, filled, disabled": "background/neutral/subtlest | - | text/neutral/subtler | icon/neutral/subtler | - | -",
    "brand, stroke, disabled": "background/neutral/subtlest | - | text/neutral/subtler | icon/neutral/subtler | - | -",
    "brand, lighter, disabled": "background/neutral/subtlest | - | text/neutral/subtler | icon/neutral/subtler | - | -",
    "brand, ghost, disabled": "- | - | text/neutral/subtler | icon/neutral/subtler | - | -",
    "destructive, filled, default": "background/system/error/bold | - | text/neutral/extra-subtle | icon/neutral/extra-subtle | - | -",
    "destructive, stroke, default": "background/neutral/extra-subtle | border/system/error/base | text/system/error/base | icon/system/error/base | - | -",
    "destructive, lighter, default": "background/system/error/subtlest | - | text/system/error/base | icon/system/error/base | - | -",
    "destructive, ghost, default": "- | - | text/system/error/base | icon/system/error/base | - | -",
    "destructive, filled, hover": "background/system/error/stronger | - | text/neutral/extra-subtle | icon/neutral/extra-subtle | - | -",
    "destructive, stroke, hover": "background/system/error/subtlest | border/system/error/base | text/system/error/base | icon/system/error/base | - | -",
    "destructive, lighter, hover": "background/system/error/subtler | - | text/system/error/base | icon/system/error/base | - | -",
    "destructive, ghost, hover": "background/system/error/subtlest | - | text/system/error/base | icon/system/error/base | - | -",
    "destructive, filled, focus": "background/system/error/bold | - | text/neutral/extra-subtle | icon/neutral/extra-subtle | focus-ring/error | -",
    "destructive, stroke, focus": "background/neutral/extra-subtle | border/system/error/base | text/system/error/base | icon/system/error/base | focus-ring/error | -",
    "destructive, lighter, focus": "background/system/error/subtlest | - | text/system/error/base | icon/system/error/base | focus-ring/error | -",
    "destructive, ghost, focus": "background/neutral/extra-subtle | - | text/system/error/base | icon/system/error/base | focus-ring/error | -",
    "destructive, filled, disabled": "background/neutral/subtlest | - | text/neutral/subtler | icon/neutral/subtler | - | -",
    "destructive, stroke, disabled": "background/neutral/subtlest | - | text/neutral/subtler | icon/neutral/subtler | - | -",
    "destructive, lighter, disabled": "background/neutral/subtlest | - | text/neutral/subtler | icon/neutral/subtler | - | -",
    "destructive, ghost, disabled": "- | - | text/neutral/subtler | icon/neutral/subtler | - | -",
    "static-black, filled, default": "background/static/dark/base | - | text/static/light | icon/static/light | - | -",
    "static-black, stroke, default": "- | border/static/dark | text/static/dark | icon/static/dark | - | -",
    "static-black, lighter, default": "background/neutral/alpha/black/8 | - | text/static/dark | icon/static/dark | - | -",
    "static-black, ghost, default": "- | - | text/static/dark | icon/static/dark | - | -",
    "static-black, filled, hover": "background/static/dark/hover | - | text/static/light | icon/static/light | - | -",
    "static-black, stroke, hover": "background/neutral/alpha/black/8 | border/static/dark | text/static/dark | icon/static/dark | - | -",
    "static-black, lighter, hover": "background/neutral/alpha/black/12 | - | text/static/dark | icon/static/dark | - | -",
    "static-black, ghost, hover": "background/neutral/alpha/black/8 | - | text/static/dark | icon/static/dark | - | -",
    "static-black, filled, focus": "background/static/dark/base | - | text/static/light | icon/static/light | - | -",
    "static-black, stroke, focus": "- | border/static/dark | text/static/dark | icon/static/dark | - | -",
    "static-black, lighter, focus": "background/neutral/alpha/black/8 | - | text/static/dark | icon/static/dark | - | -",
    "static-black, ghost, focus": "- | - | text/static/dark | icon/static/dark | - | -",
    "static-black, filled, disabled": "background/static/dark/base | - | text/static/light | icon/static/light | - | opacity/disabled",
    "static-black, stroke, disabled": "- | border/static/dark | text/static/dark | icon/static/dark | - | opacity/disabled",
    "static-black, lighter, disabled": "background/neutral/alpha/black/8 | - | text/static/dark | icon/static/dark | - | opacity/disabled",
    "static-black, ghost, disabled": "- | - | text/static/dark | icon/static/dark | - | opacity/disabled",
    "static-white, filled, default": "background/static/light/base | - | text/static/dark | icon/static/dark | - | -",
    "static-white, stroke, default": "- | border/static/light | text/static/light | icon/static/light | - | -",
    "static-white, lighter, default": "background/neutral/alpha/white/12 | - | text/static/light | icon/static/light | - | -",
    "static-white, ghost, default": "- | - | text/static/light | icon/static/light | - | -",
    "static-white, filled, hover": "background/static/light/hover | - | text/static/dark | icon/static/dark | - | -",
    "static-white, stroke, hover": "background/neutral/alpha/white/8 | border/static/light | text/static/light | icon/static/light | - | -",
    "static-white, lighter, hover": "background/neutral/alpha/white/16 | - | text/static/light | icon/static/light | - | -",
    "static-white, ghost, hover": "background/neutral/alpha/white/8 | - | text/static/light | icon/static/light | - | -",
    "static-white, filled, focus": "background/static/light/base | - | text/static/dark | icon/static/dark | - | -",
    "static-white, stroke, focus": "- | border/static/light | text/static/light | icon/static/light | - | -",
    "static-white, lighter, focus": "background/neutral/alpha/white/12 | - | text/static/light | icon/static/light | - | -",
    "static-white, ghost, focus": "- | - | text/static/light | icon/static/light | - | -",
    "static-white, filled, disabled": "background/static/light/base | - | text/static/dark | icon/static/dark | - | opacity/disabled",
    "static-white, stroke, disabled": "- | border/static/light | text/static/light | icon/static/light | - | opacity/disabled",
    "static-white, lighter, disabled": "background/neutral/alpha/white/12 | - | text/static/light | icon/static/light | - | opacity/disabled",
    "static-white, ghost, disabled": "- | - | text/static/light | icon/static/light | - | opacity/disabled"
  },
  "notes": ["In Figma the static-black and static-white focus variants carry no focus-ring effect style; the code uses focus-ring/neutral for them (flagged to the designer)."]
}
