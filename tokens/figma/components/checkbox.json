{
  "_Checkbox box": {
    "props": {"checked": ["false", "true", "indeterminate"], "state": ["default", "hover", "focus", "read-only", "disabled"]},
    "root": {"hitArea": "size/2xs × size/2xs, centered", "Box": "size/3xs × size/3xs, radius/sm, stroke 1 inside"},
    "icon": {"true": "Check", "indeterminate": "Minus", "format": "Stroke Regular", "strokeWeight": 1.5},
    "matrix": {
      "false/default": {"bg": "background/neutral/extra-subtle", "border": "border/neutral/base"},
      "false/hover": {"bg": "background/neutral/subtlest", "border": "border/neutral/strongest"},
      "false/focus": {"bg": "background/neutral/extra-subtle", "border": "border/neutral/base", "effect": "focus-ring/brand"},
      "false/read-only": {"bg": "background/neutral/subtlest", "border": "border/neutral/subtler"},
      "false/disabled": {"bg": "background/neutral/subtlest", "border": "border/neutral/subtler"},
      "checked/default": {"bg": "background/brand/base", "border": null, "icon": "icon/neutral/extra-subtle"},
      "checked/hover": {"bg": "background/brand/bold", "border": null, "icon": "icon/neutral/extra-subtle"},
      "checked/focus": {"bg": "background/brand/base", "border": null, "icon": "icon/neutral/extra-subtle", "effect": "focus-ring/brand"},
      "checked/read-only": {"bg": "background/brand/base", "border": null, "icon": "icon/neutral/extra-subtle"},
      "checked/disabled": {"bg": "background/neutral/soft", "border": null, "icon": "icon/neutral/subtler"},
      "note": "checked = true or indeterminate (same colours, different icon)"
    }
  },
  "Checkbox": {
    "props": {"show-label": true, "label": "Checkbox label", "show-description": false, "description": "Insert the checkbox description here.", "checked": ["false", "true", "indeterminate"], "state": ["default", "hover", "focus", "read-only", "disabled"]},
    "root": {"layout": "HORIZONTAL", "gap": "gap/2xs", "align": "MIN/MIN"},
    "Box": "_Checkbox box instance (checked/state passed through)",
    "Text": {"layout": "VERTICAL", "gap": "gap/3xs", "Label": {"style": "sm/medium", "color": "text/neutral/strongest"}, "Description": {"style": "sm/regular", "color": "text/neutral/soft", "hiddenByDefault": true}},
    "disabled": {"Label": "text/neutral/subtler", "Description": "text/neutral/subtler"}
  },
  "Checkbox group": {
    "props": {"show-label": true, "label": "Group label", "orientation": ["vertical", "horizontal"]},
    "root": {"layout": "VERTICAL", "gap": "gap/md"},
    "Label": {"style": "sm/medium", "color": "text/neutral/strongest"},
    "Options": {"layout": "VERTICAL (vertical) / HORIZONTAL (horizontal)", "gap": "gap/md", "slots": "Checkbox 1…10 (1-3 visible by default in vertical; 1-3 in horizontal)"}
  }
}
