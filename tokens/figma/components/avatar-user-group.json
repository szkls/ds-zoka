    "avatars": "Avatar 1, 2, 4 = type=image; Avatar 3 = type=initials (brand background)",
    "avatarSize": {"xs": "size/2xs", "sm": "size/xs", "md": "size/md", "lg": "size/xl", "xl": "size/2xl"},
    "Counter": {"circle": {"fill": "background/neutral/subtler", "radius": "radius/full", "size": "= avatar size"}, "text": {"color": "text/neutral/base", "style": {"xs": "xs/semi-bold", "sm": "xs/semi-bold", "md": "sm/semi-bold", "lg": "md/semi-bold", "xl": "lg/semi-bold"}}},
    "Add button": {"component": "_Avatar add (orphaned in Figma, see notes)", "fill": "background/neutral/subtlest", "stroke": "border/neutral/base", "strokeWeight": "border/xs", "dash": "2/2", "radius": "radius/full", "icon": "Plus", "iconColor": "icon/neutral/soft", "iconSw": 1.5, "iconSize": {"xs": "size/4xs", "sm": "size/4xs", "md": "size/3xs", "lg": "size/2xs", "xl": "size/xs"}, "states": {"hover": {"fill": "background/neutral/subtler", "stroke": "border/neutral/bold", "icon": "icon/neutral/strongest"}, "focus": {"stroke": "border/neutral/strongest", "effect": "focus-ring/neutral", "icon": "icon/neutral/strongest"}, "disabled": {"opacity": "opacity/disabled"}}}
  }
